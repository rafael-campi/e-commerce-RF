PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=docker
DB_PASSWORD=docker
DB_NAME=ecommerce
SECRET_KEY_JWT=troque-este-segredo

# PSP próprio (payment-ledger-service, docs/adr/0001). Sem PSP_URL, todo
# pagamento é aprovado na hora pelo gateway local (como no CI).
# `PLATFORM_ADMIN_TOKEN=... yarn psp:setup` preenche estas quatro:
# PSP_URL=http://localhost:3001
# PSP_SECRET_KEY=sk_test_...
# PSP_PUBLISHABLE_KEY=pk_test_...   (vai para o navegador tokenizar o cartão)
# PSP_WEBHOOK_SECRET=whsec_...
# Como o navegador chega ao PSP: /psp (proxy do Vite) em dev; vazio atrás do api-gateway
# PSP_PUBLIC_URL=/psp
# Confere no PSP Pix pendentes cujo webhook se perdeu; 0 desliga
PAYMENTS_RECONCILE_INTERVAL_MS=60000
