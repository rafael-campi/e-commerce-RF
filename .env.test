# Banco de teste isolado (docker compose up -d dbtest). Sem segredos reais.
DB_HOST=localhost
DB_PORT=5434
DB_USER=docker
DB_PASSWORD=docker
DB_NAME=ecommerce_test
SECRET_KEY_JWT=test-secret
# Webhooks do PSP: os testes assinam as entregas com este segredo
PSP_WEBHOOK_SECRET=whsec_test_ecommerce
# os testes chamam PaymentsService.reconcile direto
PAYMENTS_RECONCILE_INTERVAL_MS=0
# Sem PSP nos testes, mesmo que o .env de dev aponte para um (o Nest também
# carrega o .env, mas não sobrescreve variáveis já definidas, nem vazias)
PSP_URL=
